# Supabase (safe to expose client-side — anon key is public by design)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Legacy/local-only admin password fallback (unused once Supabase Auth is wired for admin login)
VITE_ADMIN_PASSWORD=change-me

# --- Server-side only secrets (set these in Supabase Edge Function secrets, NOT here) ---
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_ENV=sandbox   # sandbox | production
#
# Google Reviews (see supabase/functions/google-reviews). Set with:
#   supabase secrets set GOOGLE_PLACES_API_KEY=<the key the owner shared>
#   supabase secrets set GOOGLE_PLACE_ID=<her Google Business Profile Place ID>
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
